#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область СлужебныйПрограммныйИнтерфейс

// Подбирает действующие в месяце договоры абонентского обслуживания и при необходимости
// создает по ним акты (документы РеализацияТоваровУслуг).
// Вызывается в фоновом задании через механизм длительных операций БСП.
//
// Параметры:
//  Период - Дата - любая дата месяца, за который формируются акты.
//  СоздаватьДокументы - Булево - Истина, если нужно создать недостающие акты;
//                                Ложь - только заполнить список договоров.
//
// Возвращаемое значение:
//  ТаблицаЗначений - строки для табличной части Договоры обработки.
//
Функция ЗаполнитьИСоздатьАкты(Знач Период, Знач СоздаватьДокументы) Экспорт
	
	НачалоПериода = НачалоМесяца(Период);
	КонецПериода = КонецМесяца(Период);
	
	Договоры = ДоговорыИАктыЗаПериод(НачалоПериода, КонецПериода);
	Договоры.Колонки.Добавить("Результат", ОбщегоНазначения.ОписаниеТипаСтрока(200));
	
	Для Каждого СтрокаДоговора Из Договоры Цикл
		
		Если ЗначениеЗаполнено(СтрокаДоговора.Реализация) Тогда
			СтрокаДоговора.Результат = НСтр("ru = 'Акт за месяц уже создан'");
			Продолжить;
		КонецЕсли;
		
		Если Не СоздаватьДокументы Тогда
			СтрокаДоговора.Результат = НСтр("ru = 'Акт будет создан'");
			Продолжить;
		КонецЕсли;
		
		СоздатьАкт(СтрокаДоговора, КонецПериода);
		
	КонецЦикла;
	
	Возврат Договоры;
	
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ДоговорыИАктыЗаПериод(НачалоПериода, КонецПериода)
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Реализация.Договор КАК Договор,
	|	МАКСИМУМ(Реализация.Ссылка) КАК Реализация
	|ПОМЕСТИТЬ ВТ_Акты
	|ИЗ
	|	Документ.РеализацияТоваровУслуг КАК Реализация
	|ГДЕ
	|	Реализация.Дата МЕЖДУ &НачалоПериода И &КонецПериода
	|	И НЕ Реализация.ПометкаУдаления
	|	И Реализация.Договор.ВидДоговора = ЗНАЧЕНИЕ(Перечисление.ВидыДоговоровКонтрагентов.ВКМ_АбонентскоеОбслуживание)
	|
	|СГРУППИРОВАТЬ ПО
	|	Реализация.Договор
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	Договор
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ДоговорыКонтрагентов.Ссылка КАК Договор,
	|	ДоговорыКонтрагентов.Владелец КАК Контрагент,
	|	ДоговорыКонтрагентов.Организация КАК Организация,
	|	ЕСТЬNULL(ВТ_Акты.Реализация, ЗНАЧЕНИЕ(Документ.РеализацияТоваровУслуг.ПустаяСсылка)) КАК Реализация,
	|	ЕСТЬNULL(ВТ_Акты.Реализация.СуммаДокумента, 0) КАК СуммаДокумента
	|ИЗ
	|	Справочник.ДоговорыКонтрагентов КАК ДоговорыКонтрагентов
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_Акты КАК ВТ_Акты
	|		ПО ДоговорыКонтрагентов.Ссылка = ВТ_Акты.Договор
	|ГДЕ
	|	ДоговорыКонтрагентов.ВидДоговора = ЗНАЧЕНИЕ(Перечисление.ВидыДоговоровКонтрагентов.ВКМ_АбонентскоеОбслуживание)
	|	И НЕ ДоговорыКонтрагентов.ПометкаУдаления
	|	И ДоговорыКонтрагентов.ВКМ_ДатаНачала <= &КонецПериода
	|	И (ДоговорыКонтрагентов.ВКМ_ДатаОкончания >= &НачалоПериода
	|			ИЛИ ДоговорыКонтрагентов.ВКМ_ДатаОкончания = ДАТАВРЕМЯ(1, 1, 1))
	|
	|УПОРЯДОЧИТЬ ПО
	|	ДоговорыКонтрагентов.Владелец.Наименование,
	|	ДоговорыКонтрагентов.Наименование";
	Запрос.УстановитьПараметр("НачалоПериода", НачалоПериода);
	Запрос.УстановитьПараметр("КонецПериода", КонецПериода);
	
	Возврат Запрос.Выполнить().Выгрузить();
	
КонецФункции

Процедура СоздатьАкт(СтрокаДоговора, ДатаАкта)
	
	НачатьТранзакцию();
	Попытка
		
		Акт = Документы.РеализацияТоваровУслуг.СоздатьДокумент();
		Акт.Дата = ДатаАкта;
		
		// Стандартный алгоритм заполнения документа.
		ДанныеЗаполнения = Новый Структура;
		ДанныеЗаполнения.Вставить("Организация", СтрокаДоговора.Организация);
		ДанныеЗаполнения.Вставить("Контрагент", СтрокаДоговора.Контрагент);
		ДанныеЗаполнения.Вставить("Договор", СтрокаДоговора.Договор);
		Акт.Заполнить(ДанныеЗаполнения);
		
		Акт.ВКМ_ВыполнитьАвтозаполнение();
		
		// Стандартный алгоритм проверки заполнения перед проведением.
		Если Акт.ПроверитьЗаполнение() Тогда
			Акт.Записать(РежимЗаписиДокумента.Проведение);
			СтрокаДоговора.Результат = НСтр("ru = 'Акт создан и проведен'");
		Иначе
			Акт.Записать(РежимЗаписиДокумента.Запись);
			СтрокаДоговора.Результат = НСтр("ru = 'Акт создан, но не проведен: не прошел проверку заполнения'");
		КонецЕсли;
		
		ЗафиксироватьТранзакцию();
		
	Исключение
		
		ОтменитьТранзакцию();
		СтрокаДоговора.Результат = СтрШаблон(НСтр("ru = 'Ошибка: %1'"),
			ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
		ЗаписьЖурналаРегистрации(НСтр("ru = 'ВКМ.Массовое создание актов'", ОбщегоНазначения.КодОсновногоЯзыка()),
			УровеньЖурналаРегистрации.Ошибка, Метаданные.Обработки.ВКМ_МассовоеСозданиеАктов, СтрокаДоговора.Договор,
			ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		Возврат;
		
	КонецПопытки;
	
	СтрокаДоговора.Реализация = Акт.Ссылка;
	СтрокаДоговора.СуммаДокумента = Акт.СуммаДокумента;
	
КонецПроцедуры

#КонецОбласти

#КонецЕсли
