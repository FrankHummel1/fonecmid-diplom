#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область СлужебныйПрограммныйИнтерфейс

// Создает демонстрационные данные: справочники, пользователей с группами доступа,
// документы обслуживания клиентов и расчета зарплаты за 2026 год, и проводит их.
// Повторный запуск не дублирует справочники (поиск по наименованию).
//
// Возвращаемое значение:
//  Строка - протокол заполнения.
//
Функция ЗаполнитьДемоДанные() Экспорт
	
	Если Не Пользователи.ЭтоПолноправныйПользователь() Тогда
		ВызватьИсключение НСтр("ru = 'Заполнение демонстрационных данных доступно только администратору.'");
	КонецЕсли;
	
	Протокол = Новый Массив;
	Контекст = Новый Структура;
	Контекст.Вставить("Протокол", Протокол);
	
	ЗаполнитьСправочники(Контекст);
	ЗаполнитьПользователей(Контекст);
	ЗаполнитьСотрудниковИУсловияОплаты(Контекст);
	ЗаполнитьДокументыПоставщика(Контекст);
	ЗаполнитьОбслуживанияИАкты(Контекст);
	ЗаполнитьЗарплату(Контекст);
	
	Протокол.Добавить(НСтр("ru = 'Готово.'"));
	Возврат СтрСоединить(Протокол, Символы.ПС);
	
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

#Область Справочники

Процедура ЗаполнитьСправочники(Контекст)
	
	Единицы = Новый Соответствие;
	Для Каждого Имя Из СтрРазделить("шт,ч,мес,уп,компл", ",") Цикл
		Единицы.Вставить(Имя, ЭлементСправочника("ЕдиницыИзмерения", Имя));
	КонецЦикла;
	Контекст.Вставить("Единицы", Единицы);
	
	Группы = Новый Массив;
	Для Каждого Имя Из СтрРазделить("Услуги,Расходные материалы,Периферия,Комплектующие,Программное обеспечение", ",") Цикл
		Группы.Добавить(ЭлементСправочника("НоменклатурныеГруппы", Имя));
	КонецЦикла;
	
	Услуга = Перечисления.ВидыНоменклатуры.Услуга;
	Товар = Перечисления.ВидыНоменклатуры.Товар;
	Номенклатура = Новый Структура;
	Номенклатура.Вставить("АбонентскаяПлата", СоздатьНоменклатуру("Абонентское обслуживание", Услуга, Единицы["мес"], Группы[0]));
	Номенклатура.Вставить("РаботыСпециалиста", СоздатьНоменклатуру("Работы специалиста", Услуга, Единицы["ч"], Группы[0]));
	Номенклатура.Вставить("НастройкаСервера", СоздатьНоменклатуру("Настройка сервера", Услуга, Единицы["ч"], Группы[0]));
	Номенклатура.Вставить("УстановкаПО", СоздатьНоменклатуру("Установка ПО", Услуга, Единицы["шт"], Группы[4]));
	Номенклатура.Вставить("Картридж", СоздатьНоменклатуру("Картридж лазерный", Товар, Единицы["шт"], Группы[1]));
	Номенклатура.Вставить("Мышь", СоздатьНоменклатуру("Мышь беспроводная", Товар, Единицы["шт"], Группы[2]));
	Номенклатура.Вставить("Клавиатура", СоздатьНоменклатуру("Клавиатура", Товар, Единицы["шт"], Группы[2]));
	Номенклатура.Вставить("ОЗУ", СоздатьНоменклатуру("Модуль памяти 16 ГБ", Товар, Единицы["шт"], Группы[3]));
	Контекст.Вставить("Номенклатура", Номенклатура);
	
	Константы.ВКМ_НоменклатураАбонентскаяПлата.Установить(Номенклатура.АбонентскаяПлата);
	Константы.ВКМ_НоменклатураРаботыСпециалиста.Установить(Номенклатура.РаботыСпециалиста);
	
	Организации = Новый Массив;
	Для Каждого Имя Из СтрРазделить("ООО ""Ваш компьютерный мастер"",ООО ""ВКМ Сервис"",ООО ""ВКМ Юг"",ИП Мастеров А.А.,ООО ""ВКМ Север""", ",") Цикл
		Организации.Добавить(ЭлементСправочника("Организации", Имя));
	КонецЦикла;
	Организация = Организации[0];
	Контекст.Вставить("Организация", Организация);
	
	ДанныеКлиентов = Новый Массив;
	ДанныеКлиентов.Добавить(ОписаниеКлиента("ВКМ Тест", "Абонентский договор VA", 5000, 2000));
	ДанныеКлиентов.Добавить(ОписаниеКлиента("ООО Ромашка", "Абонентский договор № 1", 8000, 1800));
	ДанныеКлиентов.Добавить(ОписаниеКлиента("ООО Вектор", "Абонентский договор № 2", 12000, 2200));
	ДанныеКлиентов.Добавить(ОписаниеКлиента("ИП Соколов", "Абонентский договор № 3", 3000, 1500));
	ДанныеКлиентов.Добавить(ОписаниеКлиента("ООО Альфа-Сервис", "Абонентский договор № 4", 0, 2500));
	ДанныеКлиентов.Добавить(ОписаниеКлиента("АО Северный ветер", "Абонентский договор № 5", 15000, 2000));
	
	Клиенты = Новый Массив;
	Для Каждого Данные Из ДанныеКлиентов Цикл
		Клиент = ЭлементСправочника("Контрагенты", Данные.Имя);
		Абонентский = Договор(Клиент, Организация, Данные.Договор, Перечисления.ВидыДоговоровКонтрагентов.ВКМ_АбонентскоеОбслуживание,
			Данные.Плата, Данные.Ставка);
		Продажа = Договор(Клиент, Организация, "Договор продажи", Перечисления.ВидыДоговоровКонтрагентов.Покупатель);
		Поставка = Договор(Клиент, Организация, "Договор поставки", Перечисления.ВидыДоговоровКонтрагентов.Поставщик);
		Клиенты.Добавить(ОписаниеДоговоровКлиента(Клиент, Абонентский, Продажа, Поставка));
	КонецЦикла;
	Контекст.Вставить("Клиенты", Клиенты);
	
	Контекст.Протокол.Добавить(НСтр("ru = 'Справочники заполнены: организации, контрагенты, договоры, номенклатура.'"));
	
КонецПроцедуры

Функция ЭлементСправочника(ИмяСправочника, Наименование)
	
	Ссылка = Справочники[ИмяСправочника].НайтиПоНаименованию(Наименование, Истина);
	Если ЗначениеЗаполнено(Ссылка) Тогда
		Возврат Ссылка;
	КонецЕсли;
	
	Элемент = Справочники[ИмяСправочника].СоздатьЭлемент();
	Элемент.Наименование = Наименование;
	Элемент.Записать();
	Возврат Элемент.Ссылка;
	
КонецФункции

Функция СоздатьНоменклатуру(Наименование, Вид, Единица, Группа)
	
	Ссылка = Справочники.Номенклатура.НайтиПоНаименованию(Наименование, Истина);
	Если ЗначениеЗаполнено(Ссылка) Тогда
		Возврат Ссылка;
	КонецЕсли;
	
	Элемент = Справочники.Номенклатура.СоздатьЭлемент();
	Элемент.Наименование = Наименование;
	Элемент.ВидНоменклатуры = Вид;
	Элемент.ЕдиницаИзмерения = Единица;
	Элемент.НоменклатурнаяГруппа = Группа;
	Элемент.Записать();
	Возврат Элемент.Ссылка;
	
КонецФункции

Функция Договор(Клиент, Организация, Наименование, ВидДоговора, Плата = 0, Ставка = 0)
	
	Ссылка = Справочники.ДоговорыКонтрагентов.НайтиПоНаименованию(Наименование, Истина, , Клиент);
	Если ЗначениеЗаполнено(Ссылка) Тогда
		Возврат Ссылка;
	КонецЕсли;
	
	Элемент = Справочники.ДоговорыКонтрагентов.СоздатьЭлемент();
	Элемент.Владелец = Клиент;
	Элемент.Наименование = Наименование;
	Элемент.Организация = Организация;
	Элемент.ВидДоговора = ВидДоговора;
	Если ВидДоговора = Перечисления.ВидыДоговоровКонтрагентов.ВКМ_АбонентскоеОбслуживание Тогда
		Элемент.ВКМ_ДатаНачала = Дата(2026, 1, 1);
		Элемент.ВКМ_ДатаОкончания = Дата(2027, 12, 31);
		Элемент.ВКМ_СуммаАбонентскойПлаты = Плата;
		Элемент.ВКМ_СтоимостьЧасаРаботы = Ставка;
	КонецЕсли;
	Элемент.Записать();
	Возврат Элемент.Ссылка;
	
КонецФункции

#КонецОбласти

#Область ОписанияДанных

Функция ОписаниеКлиента(Имя, Договор, Плата, Ставка)
	
	Результат = Новый Структура;
	Результат.Вставить("Имя", Имя);
	Результат.Вставить("Договор", Договор);
	Результат.Вставить("Плата", Плата);
	Результат.Вставить("Ставка", Ставка);
	Возврат Результат;
	
КонецФункции

Функция ОписаниеДоговоровКлиента(Клиент, Абонентский, Продажа, Поставка)
	
	Результат = Новый Структура;
	Результат.Вставить("Клиент", Клиент);
	Результат.Вставить("Абонентский", Абонентский);
	Результат.Вставить("Продажа", Продажа);
	Результат.Вставить("Поставка", Поставка);
	Возврат Результат;
	
КонецФункции

Функция ОписаниеСотрудника(Имя, Должность, Оклад, Процент, Пользователь)
	
	Результат = Новый Структура;
	Результат.Вставить("Имя", Имя);
	Результат.Вставить("Должность", Должность);
	Результат.Вставить("Оклад", Оклад);
	Результат.Вставить("Процент", Процент);
	Результат.Вставить("Пользователь", Пользователь);
	Возврат Результат;
	
КонецФункции

#КонецОбласти

#Область Пользователи

Процедура ЗаполнитьПользователей(Контекст)
	
	Пользователи_ = Новый Структура;
	Пользователи_.Вставить("Администратор", Пользователь("Администратор", "Администратор", Истина));
	Пользователи_.Вставить("Менеджер", Пользователь("Менеджер", "Менеджер Смирнова М.", Ложь));
	Пользователи_.Вставить("Специалист", Пользователь("Специалист", "Специалист Тестов Т.", Ложь));
	Пользователи_.Вставить("Бухгалтер", Пользователь("Бухгалтер", "Бухгалтер Орлова Е.", Ложь));
	Пользователи_.Вставить("Кадровик", Пользователь("Кадровик", "Кадровик Волкова И.", Ложь));
	Контекст.Вставить("Пользователи", Пользователи_);
	
	ВключитьВГруппуДоступа("Администраторы", Неопределено, Пользователи_.Администратор);
	ВключитьВГруппуДоступа("Менеджеры", "c5b13e3e-94a7-4f1d-940b-d537ff822cb6", Пользователи_.Менеджер);
	ВключитьВГруппуДоступа("Специалисты", "1c0bc26a-d168-48ae-a7e3-40317064c744", Пользователи_.Специалист);
	ВключитьВГруппуДоступа("Бухгалтеры", "d75a8226-7b53-4f4a-bfc3-768333ba6872", Пользователи_.Бухгалтер);
	ВключитьВГруппуДоступа("Кадровики-расчетчики", "22898dfb-be23-419f-9d67-4c7596b377df", Пользователи_.Кадровик);
	
	Контекст.Протокол.Добавить(НСтр("ru = 'Пользователи и группы доступа созданы.'"));
	
КонецПроцедуры

Функция Пользователь(Логин, Наименование, ЭтоАдминистратор)
	
	Если ЭтоАдминистратор Тогда
		// Первого администратора создаем штатным механизмом БСП.
		Администратор = Пользователи.СоздатьАдминистратора();
		Если Администратор <> Неопределено Тогда
			Возврат Администратор;
		КонецЕсли;
	КонецЕсли;
	
	Ссылка = Справочники.Пользователи.НайтиПоНаименованию(Наименование, Истина);
	Если ЗначениеЗаполнено(Ссылка) Тогда
		Возврат Ссылка;
	КонецЕсли;
	
	ОписаниеПользователяИБ = Новый Структура;
	ОписаниеПользователяИБ.Вставить("Действие", "Записать");
	ОписаниеПользователяИБ.Вставить("Имя", Логин);
	ОписаниеПользователяИБ.Вставить("ВходВПрограммуРазрешен", Истина);
	ОписаниеПользователяИБ.Вставить("АутентификацияСтандартная", Истина);
	ОписаниеПользователяИБ.Вставить("ПоказыватьВСпискеВыбора", Истина);
	ОписаниеПользователяИБ.Вставить("Пароль", "");
	Если ЭтоАдминистратор Тогда
		Роли = Новый Массив;
		Роли.Добавить("ПолныеПрава");
		Роли.Добавить("АдминистраторСистемы");
		ОписаниеПользователяИБ.Вставить("Роли", Роли);
	КонецЕсли;
	
	Элемент = Справочники.Пользователи.СоздатьЭлемент();
	Элемент.Наименование = Наименование;
	Элемент.ДополнительныеСвойства.Вставить("ОписаниеПользователяИБ", ОписаниеПользователяИБ);
	Элемент.Записать();
	Возврат Элемент.Ссылка;
	
КонецФункции

Процедура ВключитьВГруппуДоступа(ИмяГруппы, ИдентификаторПрофиля, Пользователь)
	
	Если ИдентификаторПрофиля = Неопределено Тогда
		Группа = Справочники.ГруппыДоступа.Администраторы.ПолучитьОбъект();
	Иначе
		Ссылка = Справочники.ГруппыДоступа.НайтиПоНаименованию(ИмяГруппы, Истина);
		Если ЗначениеЗаполнено(Ссылка) Тогда
			Группа = Ссылка.ПолучитьОбъект();
		Иначе
			Группа = Справочники.ГруппыДоступа.СоздатьЭлемент();
			Группа.Наименование = ИмяГруппы;
			Группа.Профиль = УправлениеДоступом.ПоставляемыйПрофильПоИдентификатору(ИдентификаторПрофиля);
		КонецЕсли;
	КонецЕсли;
	
	Если Группа.Пользователи.Найти(Пользователь, "Пользователь") = Неопределено Тогда
		Группа.Пользователи.Добавить().Пользователь = Пользователь;
	КонецЕсли;
	Группа.Записать();
	
КонецПроцедуры

#КонецОбласти

#Область Сотрудники

Процедура ЗаполнитьСотрудниковИУсловияОплаты(Контекст)
	
	ДанныеСотрудников = Новый Массив;
	ДанныеСотрудников.Добавить(ОписаниеСотрудника("Тестов Тест", "Специалист", 30000, 25, "Специалист"));
	ДанныеСотрудников.Добавить(ОписаниеСотрудника("Иванов Иван", "Ведущий специалист", 40000, 30, ""));
	ДанныеСотрудников.Добавить(ОписаниеСотрудника("Петров Петр", "Специалист", 30000, 20, ""));
	ДанныеСотрудников.Добавить(ОписаниеСотрудника("Сидорова Анна", "Специалист", 32000, 25, ""));
	ДанныеСотрудников.Добавить(ОписаниеСотрудника("Кузнецов Олег", "Стажер", 20000, 0, ""));
	ДанныеСотрудников.Добавить(ОписаниеСотрудника("Смирнова Мария", "Менеджер", 45000, 0, "Менеджер"));
	ДанныеСотрудников.Добавить(ОписаниеСотрудника("Орлова Елена", "Бухгалтер", 50000, 0, "Бухгалтер"));
	ДанныеСотрудников.Добавить(ОписаниеСотрудника("Волкова Ирина", "Кадровик-расчетчик", 48000, 0, "Кадровик"));
	
	Сотрудники = Новый Массив;
	Специалисты = Новый Массив;
	Для Каждого Данные Из ДанныеСотрудников Цикл
		
		Ссылка = Справочники.ВКМ_Сотрудники.НайтиПоНаименованию(Данные.Имя, Истина);
		Если Не ЗначениеЗаполнено(Ссылка) Тогда
			Элемент = Справочники.ВКМ_Сотрудники.СоздатьЭлемент();
			Элемент.Наименование = Данные.Имя;
			Элемент.Должность = Данные.Должность;
			Если ЗначениеЗаполнено(Данные.Пользователь) Тогда
				Элемент.Пользователь = Контекст.Пользователи[Данные.Пользователь];
			КонецЕсли;
			Элемент.Записать();
			Ссылка = Элемент.Ссылка;
		КонецЕсли;
		Сотрудники.Добавить(Ссылка);
		Если СтрНайти(Данные.Должность, "пециалист") > 0 Или Данные.Должность = "Стажер" Тогда
			Специалисты.Добавить(Ссылка);
		КонецЕсли;
		
		Запись = РегистрыСведений.ВКМ_УсловияОплатыСотрудников.СоздатьМенеджерЗаписи();
		Запись.Период = Дата(2026, 1, 1);
		Запись.Сотрудник = Ссылка;
		Запись.Оклад = Данные.Оклад;
		Запись.ПроцентОтРабот = Данные.Процент;
		Запись.Записать();
		
	КонецЦикла;
	
	// Повышение оклада ведущему специалисту с июня.
	Запись = РегистрыСведений.ВКМ_УсловияОплатыСотрудников.СоздатьМенеджерЗаписи();
	Запись.Период = Дата(2026, 6, 1);
	Запись.Сотрудник = Сотрудники[1];
	Запись.Оклад = 45000;
	Запись.ПроцентОтРабот = 30;
	Запись.Записать();
	
	Контекст.Вставить("Сотрудники", Сотрудники);
	Контекст.Вставить("Специалисты", Специалисты);
	Контекст.Протокол.Добавить(НСтр("ru = 'Сотрудники и условия оплаты заполнены.'"));
	
КонецПроцедуры

#КонецОбласти

#Область ДокументыПоставщика

Процедура ЗаполнитьДокументыПоставщика(Контекст)
	
	Если ЕстьДокументы("ЗаказПокупателя") Тогда
		Возврат;
	КонецЕсли;
	
	Номенклатура = Контекст.Номенклатура;
	Товары = Новый Массив;
	Товары.Добавить(Номенклатура.Картридж);
	Товары.Добавить(Номенклатура.Мышь);
	Товары.Добавить(Номенклатура.Клавиатура);
	Товары.Добавить(Номенклатура.ОЗУ);
	
	Для Номер = 1 По 5 Цикл
		
		Клиент = Контекст.Клиенты[Номер];
		ДатаДокумента = Дата(2026, Номер + 1, 5, 10, 0, 0);
		
		Поступление = Документы.ПоступлениеТоваровУслуг.СоздатьДокумент();
		ЗаполнитьШапку(Поступление, ДатаДокумента, Контекст.Организация, Клиент.Клиент, Клиент.Поставка);
		ДобавитьСтроки(Поступление.Товары, Товары, 10, 500 * Номер);
		Поступление.СуммаДокумента = Поступление.Товары.Итог("Сумма");
		ЗаписатьДокумент(Поступление, Контекст);
		
		Заказ = Документы.ЗаказПокупателя.СоздатьДокумент();
		ЗаполнитьШапку(Заказ, ДатаДокумента + 3600, Контекст.Организация, Клиент.Клиент, Клиент.Продажа);
		ДобавитьСтроки(Заказ.Товары, Товары, 2, 900 * Номер);
		Заказ.СуммаДокумента = Заказ.Товары.Итог("Сумма");
		ЗаписатьДокумент(Заказ, Контекст);
		
		Реализация = Документы.РеализацияТоваровУслуг.СоздатьДокумент();
		ЗаполнитьШапку(Реализация, ДатаДокумента + 7200, Контекст.Организация, Клиент.Клиент, Клиент.Продажа);
		ДобавитьСтроки(Реализация.Товары, Товары, 2, 900 * Номер);
		Реализация.Основание = Заказ.Ссылка;
		Реализация.СуммаДокумента = Реализация.Товары.Итог("Сумма");
		ЗаписатьДокумент(Реализация, Контекст);
		
		Оплата = Документы.ОплатаОтПокупателя.СоздатьДокумент();
		ЗаполнитьШапку(Оплата, ДатаДокумента + 86400, Контекст.Организация, Клиент.Клиент, Клиент.Продажа);
		Оплата.Основание = Заказ.Ссылка;
		Оплата.СуммаДокумента = Заказ.СуммаДокумента;
		ЗаписатьДокумент(Оплата, Контекст);
		
		ОплатаПоставщику = Документы.ОплатаПоставщику.СоздатьДокумент();
		ЗаполнитьШапку(ОплатаПоставщику, ДатаДокумента + 2 * 86400, Контекст.Организация, Клиент.Клиент, Клиент.Поставка);
		ОплатаПоставщику.СуммаДокумента = Поступление.СуммаДокумента;
		ЗаписатьДокумент(ОплатаПоставщику, Контекст);
		
	КонецЦикла;
	
	Контекст.Протокол.Добавить(НСтр("ru = 'Документы покупок и продаж созданы.'"));
	
КонецПроцедуры

Процедура ЗаполнитьШапку(Документ, ДатаДокумента, Организация, Контрагент, Договор)
	
	Документ.Дата = ДатаДокумента;
	Документ.Организация = Организация;
	Документ.Контрагент = Контрагент;
	Документ.Договор = Договор;
	
КонецПроцедуры

Процедура ДобавитьСтроки(ТабличнаяЧасть, Номенклатура, Количество, Цена)
	
	Для Индекс = 0 По 2 Цикл
		Строка = ТабличнаяЧасть.Добавить();
		Строка.Номенклатура = Номенклатура[Индекс];
		Строка.Количество = Количество + Индекс;
		Строка.Цена = Цена + 100 * Индекс;
		Строка.Сумма = Строка.Количество * Строка.Цена;
	КонецЦикла;
	
КонецПроцедуры

Процедура ЗаписатьДокумент(Документ, Контекст)
	
	Попытка
		Документ.Записать(РежимЗаписиДокумента.Проведение);
	Исключение
		Контекст.Протокол.Добавить(СтрШаблон(НСтр("ru = 'Не проведен %1: %2'"), Документ.Метаданные().Синоним,
			ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке())));
		Документ.Записать(РежимЗаписиДокумента.Запись);
	КонецПопытки;
	
КонецПроцедуры

#КонецОбласти

#Область ОбслуживаниеКлиентов

Процедура ЗаполнитьОбслуживанияИАкты(Контекст)
	
	Работы = СтрРазделить("Диагностика неисправности;Замена комплектующих;Настройка сети;Установка обновлений;"
		+ "Настройка резервного копирования;Консультация пользователя;Чистка системного блока;Настройка принтера", ";");
	
	КоличествоДокументов = 0;
	Для Месяц = 1 По ?(ЕстьДокументы("ВКМ_ОбслуживаниеКлиента"), 0, 10) Цикл
		Для Номер = 0 По 2 Цикл
			
			ИндексКлиента = (Месяц + Номер) % Контекст.Клиенты.Количество();
			Клиент = Контекст.Клиенты[ИндексКлиента];
			// Текущий месяц по тестовому договору оставляем пустым для автотеста.
			Если Месяц = 10 И ИндексКлиента = 0 Тогда
				Продолжить;
			КонецЕсли;
			
			День = 5 + Номер * 7;
			Обслуживание = Документы.ВКМ_ОбслуживаниеКлиента.СоздатьДокумент();
			Обслуживание.Заполнить(Неопределено);
			Обслуживание.Дата = Дата(2026, Месяц, День, 9, 0, 0);
			Обслуживание.Клиент = Клиент.Клиент;
			Обслуживание.Договор = Клиент.Абонентский;
			Обслуживание.Специалист = Контекст.Специалисты[(Месяц + Номер) % Контекст.Специалисты.Количество()];
			Обслуживание.ДатаПроведенияРабот = Дата(2026, Месяц, День);
			Обслуживание.ВремяНачалаРабот = Дата(1, 1, 1, 10, 0, 0);
			Обслуживание.ВремяОкончанияРабот = Дата(1, 1, 1, 15, 0, 0);
			Обслуживание.ОписаниеПроблемы = СтрШаблон(НСтр("ru = 'Заявка клиента: %1'"), НРег(Работы[(Месяц + Номер) % Работы.Количество()]));
			Обслуживание.Ответственный = Контекст.Пользователи.Менеджер;
			Для Строка = 0 По 2 Цикл
				НоваяСтрока = Обслуживание.ВыполненныеРаботы.Добавить();
				НоваяСтрока.ОписаниеРабот = Работы[(Месяц + Номер + Строка) % Работы.Количество()];
				НоваяСтрока.ФактическиПотраченоЧасов = 1 + (Строка + Номер) % 3 + 0.5;
				НоваяСтрока.ЧасыКОплатеКлиенту = 1 + (Строка + Номер) % 3;
			КонецЦикла;
			ЗаписатьДокумент(Обслуживание, Контекст);
			КоличествоДокументов = КоличествоДокументов + 1;
			
		КонецЦикла;
	КонецЦикла;
	Контекст.Протокол.Добавить(СтрШаблон(НСтр("ru = 'Создано обслуживаний клиентов: %1.'"), КоличествоДокументов));
	
	// Механизм массового создания актов за январь - сентябрь.
	Для Месяц = 1 По 9 Цикл
		Обработки.ВКМ_МассовоеСозданиеАктов.ЗаполнитьИСоздатьАкты(Дата(2026, Месяц, 1), Истина);
	КонецЦикла;
	ПровестиНепроведенныеАкты(Контекст);
	Контекст.Протокол.Добавить(НСтр("ru = 'Акты по абонентским договорам за январь - сентябрь созданы.'"));
	
КонецПроцедуры

Процедура ПровестиНепроведенныеАкты(Контекст)
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Реализация.Ссылка КАК Ссылка
	|ИЗ
	|	Документ.РеализацияТоваровУслуг КАК Реализация
	|ГДЕ
	|	НЕ Реализация.Проведен
	|	И НЕ Реализация.ПометкаУдаления
	|	И Реализация.Договор.ВидДоговора = ЗНАЧЕНИЕ(Перечисление.ВидыДоговоровКонтрагентов.ВКМ_АбонентскоеОбслуживание)";
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Акт = Выборка.Ссылка.ПолучитьОбъект();
		Если Акт.Услуги.Количество() = 0 Тогда
			Акт.УстановитьПометкуУдаления(Истина);
		Иначе
			ЗаписатьДокумент(Акт, Контекст);
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

#КонецОбласти

#Область Зарплата

Процедура ЗаполнитьЗарплату(Контекст)
	
	Сотрудники = Контекст.Сотрудники;
	
	// Графики отпусков на 2026 год: пять документов по три сотрудника.
	Отпуска = Новый Массив;
	Отпуска.Добавить(Новый Структура("Сотрудник, Начало, Конец", 0, Дата(2026, 7, 6), Дата(2026, 7, 19)));
	Отпуска.Добавить(Новый Структура("Сотрудник, Начало, Конец", 1, Дата(2026, 8, 3), Дата(2026, 8, 16)));
	Отпуска.Добавить(Новый Структура("Сотрудник, Начало, Конец", 2, Дата(2026, 6, 15), Дата(2026, 6, 28)));
	Отпуска.Добавить(Новый Структура("Сотрудник, Начало, Конец", 3, Дата(2026, 9, 7), Дата(2026, 9, 20)));
	Отпуска.Добавить(Новый Структура("Сотрудник, Начало, Конец", 4, Дата(2026, 8, 17), Дата(2026, 8, 30)));
	Отпуска.Добавить(Новый Структура("Сотрудник, Начало, Конец", 5, Дата(2026, 7, 20), Дата(2026, 8, 2)));
	Отпуска.Добавить(Новый Структура("Сотрудник, Начало, Конец", 6, Дата(2026, 10, 5), Дата(2026, 10, 18)));
	Отпуска.Добавить(Новый Структура("Сотрудник, Начало, Конец", 7, Дата(2026, 6, 1), Дата(2026, 6, 14)));
	Отпуска.Добавить(Новый Структура("Сотрудник, Начало, Конец", 0, Дата(2026, 12, 14), Дата(2026, 12, 27)));
	Отпуска.Добавить(Новый Структура("Сотрудник, Начало, Конец", 1, Дата(2026, 12, 7), Дата(2026, 12, 20)));
	Отпуска.Добавить(Новый Структура("Сотрудник, Начало, Конец", 2, Дата(2026, 11, 9), Дата(2026, 11, 22)));
	Отпуска.Добавить(Новый Структура("Сотрудник, Начало, Конец", 3, Дата(2026, 12, 21), Дата(2026, 12, 31)));
	Отпуска.Добавить(Новый Структура("Сотрудник, Начало, Конец", 4, Дата(2026, 11, 23), Дата(2026, 12, 6)));
	Отпуска.Добавить(Новый Структура("Сотрудник, Начало, Конец", 5, Дата(2026, 11, 2), Дата(2026, 11, 15)));
	// Превышение 28 дней: третий отпуск сотрудника Тестов Т. (подсветка в форме графика).
	Отпуска.Добавить(Новый Структура("Сотрудник, Начало, Конец", 0, Дата(2026, 3, 16), Дата(2026, 3, 22)));
	
	Для НомерГрафика = 0 По ?(ЕстьДокументы("ВКМ_ГрафикОтпусков"), -1, 4) Цикл
		График = Документы.ВКМ_ГрафикОтпусков.СоздатьДокумент();
		График.Дата = Дата(2025, 12, 15 + НомерГрафика, 10, 0, 0);
		График.Год = 2026;
		График.Комментарий = СтрШаблон(НСтр("ru = 'График отпусков, часть %1'"), НомерГрафика + 1);
		Для Индекс = НомерГрафика * 3 По НомерГрафика * 3 + 2 Цикл
			Отпуск = Отпуска[Индекс];
			Строка = График.ОтпускаСотрудников.Добавить();
			Строка.Сотрудник = Сотрудники[Отпуск.Сотрудник];
			Строка.ДатаНачала = Отпуск.Начало;
			Строка.ДатаОкончания = Отпуск.Конец;
		КонецЦикла;
		ЗаписатьДокумент(График, Контекст);
	КонецЦикла;
	
	Если ЕстьДокументы("ВКМ_НачислениеЗарплаты") Тогда
		ПерепровестиДокументыЗарплаты(Контекст);
		Возврат;
	КонецЕсли;
	
	// Начисление и выплата зарплаты за январь - сентябрь, премии с мая.
	Для Месяц = 1 По 9 Цикл
		
		Начисление = Документы.ВКМ_НачислениеЗарплаты.СоздатьДокумент();
		Начисление.Дата = КонецМесяца(Дата(2026, Месяц, 1)) - 3600;
		Начисление.ЗаполнитьНачисления();
		ЗаписатьДокумент(Начисление, Контекст);
		
		Если Месяц >= 5 Тогда
			Премия = Документы.ВКМ_НачислениеФиксированнойПремии.СоздатьДокумент();
			Премия.Дата = КонецМесяца(Дата(2026, Месяц, 1)) - 1800;
			Премия.Комментарий = НСтр("ru = 'Премия по итогам периода'");
			Для Индекс = 0 По 2 Цикл
				Строка = Премия.СписокСотрудников.Добавить();
				Строка.Сотрудник = Сотрудники[(Месяц + Индекс) % Сотрудники.Количество()];
				Строка.СуммаПремии = 5000 + 2500 * Индекс;
			КонецЦикла;
			ЗаписатьДокумент(Премия, Контекст);
		КонецЕсли;
		
		Выплата = Документы.ВКМ_ВыплатаЗарплаты.СоздатьДокумент();
		Выплата.Дата = Дата(2026, Месяц + 1, 5, 12, 0, 0);
		Выплата.ЗаполнитьПоОстаткам();
		ЗаписатьДокумент(Выплата, Контекст);
		
	КонецЦикла;
	
	Контекст.Протокол.Добавить(НСтр("ru = 'Графики отпусков, начисления, премии и выплаты зарплаты созданы.'"));
	
КонецПроцедуры

// Проводит уже созданные документы зарплаты в хронологическом порядке
// (выплаты перезаполняются по остаткам на свою дату).
//
Процедура ПерепровестиДокументыЗарплаты(Контекст)
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Документы.Ссылка КАК Ссылка,
	|	Документы.Дата КАК Дата
	|ИЗ
	|	(ВЫБРАТЬ
	|		Начисление.Ссылка КАК Ссылка,
	|		Начисление.Дата КАК Дата
	|	ИЗ
	|		Документ.ВКМ_НачислениеЗарплаты КАК Начисление
	|	ГДЕ
	|		НЕ Начисление.ПометкаУдаления
	|	
	|	ОБЪЕДИНИТЬ ВСЕ
	|	
	|	ВЫБРАТЬ
	|		Премия.Ссылка,
	|		Премия.Дата
	|	ИЗ
	|		Документ.ВКМ_НачислениеФиксированнойПремии КАК Премия
	|	ГДЕ
	|		НЕ Премия.ПометкаУдаления
	|	
	|	ОБЪЕДИНИТЬ ВСЕ
	|	
	|	ВЫБРАТЬ
	|		Выплата.Ссылка,
	|		Выплата.Дата
	|	ИЗ
	|		Документ.ВКМ_ВыплатаЗарплаты КАК Выплата
	|	ГДЕ
	|		НЕ Выплата.ПометкаУдаления) КАК Документы
	|
	|УПОРЯДОЧИТЬ ПО
	|	Дата";
	
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Документ = Выборка.Ссылка.ПолучитьОбъект();
		Если ТипЗнч(Документ) = Тип("ДокументОбъект.ВКМ_ВыплатаЗарплаты") Тогда
			Документ.ЗаполнитьПоОстаткам();
		ИначеЕсли ТипЗнч(Документ) = Тип("ДокументОбъект.ВКМ_НачислениеЗарплаты") Тогда
			Документ.ЗаполнитьНачисления();
		КонецЕсли;
		ЗаписатьДокумент(Документ, Контекст);
	КонецЦикла;
	
	Контекст.Протокол.Добавить(НСтр("ru = 'Документы зарплаты перепроведены.'"));
	
КонецПроцедуры

Функция ЕстьДокументы(ИмяДокумента)
	
	Запрос = Новый Запрос;
	Запрос.Текст = СтрЗаменить(
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	1 КАК Поле1
	|ИЗ
	|	Документ.ИмяДокумента КАК Документ", "ИмяДокумента", ИмяДокумента);
	Возврат Не Запрос.Выполнить().Пустой();
	
КонецФункции

#КонецОбласти

#КонецОбласти

#КонецЕсли
