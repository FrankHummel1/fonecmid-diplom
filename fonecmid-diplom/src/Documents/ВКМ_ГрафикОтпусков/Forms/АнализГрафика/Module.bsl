#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Год = Параметры.Год;
	Заголовок = СтрШаблон(НСтр("ru = 'Анализ графика отпусков на %1 год'"), Формат(Год, "ЧГ=0"));
	
	СоздатьДиаграммуГанта();
	
	Если ЭтоАдресВременногоХранилища(Параметры.АдресДанных) Тогда
		ЗаполнитьДиаграмму(ПолучитьИзВременногоХранилища(Параметры.АдресДанных));
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Реквизит и поле диаграммы Ганта создаются программно.
//
&НаСервере
Процедура СоздатьДиаграммуГанта()
	
	НовыеРеквизиты = Новый Массив;
	НовыеРеквизиты.Добавить(Новый РеквизитФормы("ДиаграммаОтпусков", Новый ОписаниеТипов("ДиаграммаГанта"),,
		НСтр("ru = 'Отпуска сотрудников'")));
	ИзменитьРеквизиты(НовыеРеквизиты);
	
	Поле = Элементы.Добавить("ДиаграммаОтпусков", Тип("ПолеФормы"));
	Поле.Вид = ВидПоляФормы.ПолеДиаграммыГанта;
	Поле.ПутьКДанным = "ДиаграммаОтпусков";
	Поле.ПоложениеЗаголовка = ПоложениеЗаголовкаЭлементаФормы.Нет;
	Поле.РастягиватьПоГоризонтали = Истина;
	Поле.РастягиватьПоВертикали = Истина;
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьДиаграмму(Отпуска)
	
	Диаграмма = ЭтотОбъект["ДиаграммаОтпусков"];
	Диаграмма.Обновление = Ложь;
	Диаграмма.Очистить();
	Диаграмма.АвтоОпределениеПолногоИнтервала = Ложь;
	Диаграмма.УстановитьПолныйИнтервал(Дата(Год, 1, 1), КонецГода(Дата(Год, 1, 1)));
	
	Серия = Диаграмма.Серии.Добавить(НСтр("ru = 'Отпуск'"));
	
	Отпуска.Сортировать("Сотрудник, ДатаНачала");
	Для Каждого Отпуск Из Отпуска Цикл
		Если Не ЗначениеЗаполнено(Отпуск.Сотрудник) Или Не ЗначениеЗаполнено(Отпуск.ДатаНачала) Тогда
			Продолжить;
		КонецЕсли;
		Точка = Диаграмма.УстановитьТочку(Отпуск.Сотрудник);
		Значение = Диаграмма.ПолучитьЗначение(Точка, Серия);
		Интервал = Значение.Добавить();
		Интервал.Начало = Отпуск.ДатаНачала;
		Интервал.Конец = КонецДня(Отпуск.ДатаОкончания);
		Интервал.Текст = СтрШаблон("%1 - %2", Формат(Отпуск.ДатаНачала, "ДФ=дд.ММ"), Формат(Отпуск.ДатаОкончания, "ДФ=дд.ММ"));
	КонецЦикла;
	
	Диаграмма.Обновление = Истина;
	
КонецПроцедуры

#КонецОбласти
