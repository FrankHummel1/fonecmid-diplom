#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ПрограммныйИнтерфейс

// Заполняет табличную часть Начисления: оклад и процент от работ по условиям оплаты
// сотрудников, отпуска - по зарегистрированным графикам отпусков за месяц документа.
//
Процедура ЗаполнитьНачисления() Экспорт
	
	Начисления.Очистить();
	
	НачалоПериода = НачалоМесяца(Дата);
	КонецПериода = КонецМесяца(Дата);
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	УсловияОплаты.Сотрудник КАК Сотрудник,
	|	УсловияОплаты.Оклад КАК Оклад,
	|	УсловияОплаты.ПроцентОтРабот КАК ПроцентОтРабот
	|ИЗ
	|	РегистрСведений.ВКМ_УсловияОплатыСотрудников.СрезПоследних(&КонецПериода, ) КАК УсловияОплаты
	|ГДЕ
	|	НЕ УсловияОплаты.Сотрудник.ПометкаУдаления
	|
	|УПОРЯДОЧИТЬ ПО
	|	УсловияОплаты.Сотрудник.Наименование
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Отпуска.Сотрудник КАК Сотрудник,
	|	Отпуска.ДатаНачала КАК ДатаНачала,
	|	Отпуска.ДатаОкончания КАК ДатаОкончания
	|ИЗ
	|	РегистрНакопления.ВКМ_ЗапланированныеОтпуска КАК Отпуска
	|ГДЕ
	|	Отпуска.Активность
	|	И Отпуска.ДатаНачала <= &КонецПериода
	|	И Отпуска.ДатаОкончания >= &НачалоПериода
	|
	|УПОРЯДОЧИТЬ ПО
	|	Отпуска.Сотрудник.Наименование,
	|	Отпуска.ДатаНачала";
	Запрос.УстановитьПараметр("НачалоПериода", НачалоПериода);
	Запрос.УстановитьПараметр("КонецПериода", КонецПериода);
	
	Результаты = Запрос.ВыполнитьПакет();
	
	ВыборкаУсловия = Результаты[0].Выбрать();
	Пока ВыборкаУсловия.Следующий() Цикл
		Если ВыборкаУсловия.Оклад <> 0 Тогда
			ДобавитьНачисление(ВыборкаУсловия.Сотрудник, ПланыВидовРасчета.ВКМ_ОсновныеНачисления.Оклад,
				НачалоПериода, КонецПериода);
		КонецЕсли;
		Если ВыборкаУсловия.ПроцентОтРабот <> 0 Тогда
			ДобавитьНачисление(ВыборкаУсловия.Сотрудник, ПланыВидовРасчета.ВКМ_ОсновныеНачисления.ПроцентОтРабот,
				НачалоПериода, КонецПериода);
		КонецЕсли;
	КонецЦикла;
	
	ВыборкаОтпуска = Результаты[1].Выбрать();
	Пока ВыборкаОтпуска.Следующий() Цикл
		ДобавитьНачисление(ВыборкаОтпуска.Сотрудник, ПланыВидовРасчета.ВКМ_ОсновныеНачисления.Отпуск,
			Макс(ВыборкаОтпуска.ДатаНачала, НачалоПериода), Мин(ВыборкаОтпуска.ДатаОкончания, НачалоДня(КонецПериода)));
	КонецЦикла;
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытий

Процедура ОбработкаПроверкиЗаполнения(Отказ, ПроверяемыеРеквизиты)
	
	НачалоПериода = НачалоМесяца(Дата);
	КонецПериода = КонецМесяца(Дата);
	
	Для Каждого Строка Из Начисления Цикл
		
		Если Строка.ДатаОкончания < Строка.ДатаНачала Тогда
			ОбщегоНазначения.СообщитьПользователю(
				СтрШаблон(НСтр("ru = 'Строка %1: дата окончания раньше даты начала.'"), Строка.НомерСтроки),
				ЭтотОбъект, ОбщегоНазначенияКлиентСервер.ПутьКТабличнойЧасти("Начисления", Строка.НомерСтроки, "ДатаОкончания"),
				, Отказ);
		ИначеЕсли Строка.ДатаНачала < НачалоПериода Или Строка.ДатаОкончания > КонецПериода Тогда
			ОбщегоНазначения.СообщитьПользователю(
				СтрШаблон(НСтр("ru = 'Строка %1: период начисления должен входить в месяц документа.'"), Строка.НомерСтроки),
				ЭтотОбъект, ОбщегоНазначенияКлиентСервер.ПутьКТабличнойЧасти("Начисления", Строка.НомерСтроки, "ДатаНачала"),
				, Отказ);
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

Процедура ОбработкаПроведения(Отказ, РежимПроведения)
	
	// Норма рабочих дней берется из графика работы: дополняем его за расчетный и базовый периоды.
	РегистрыСведений.ВКМ_ГрафикРаботы.ЗаполнитьПоУмолчанию(ДобавитьМесяц(НачалоМесяца(Дата), -12), КонецМесяца(Дата));
	
	СформироватьДвиженияОсновныхНачислений();
	РассчитатьОсновныеНачисления();
	СформироватьДвиженияУдержаний();
	СформироватьДвиженияВзаиморасчетов();
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура ДобавитьНачисление(Сотрудник, ВидРасчета, ДатаНачала, ДатаОкончания)
	
	НоваяСтрока = Начисления.Добавить();
	НоваяСтрока.Сотрудник = Сотрудник;
	НоваяСтрока.ВидРасчета = ВидРасчета;
	НоваяСтрока.ДатаНачала = ДатаНачала;
	НоваяСтрока.ДатаОкончания = ДатаОкончания;
	
КонецПроцедуры

// Записывает движения основных начислений без сумм. При записи платформа рассчитывает
// фактический период действия с учетом вытеснения (отпуск вытесняет оклад).
//
Процедура СформироватьДвиженияОсновныхНачислений()
	
	ПериодРегистрации = НачалоМесяца(Дата);
	
	Движения.ВКМ_ОсновныеНачисления.Записывать = Истина;
	Для Каждого Строка Из Начисления Цикл
		
		Движение = Движения.ВКМ_ОсновныеНачисления.Добавить();
		Движение.ПериодРегистрации = ПериодРегистрации;
		Движение.ВидРасчета = Строка.ВидРасчета;
		Движение.Сотрудник = Строка.Сотрудник;
		Движение.ПериодДействияНачало = Строка.ДатаНачала;
		Движение.ПериодДействияКонец = КонецДня(Строка.ДатаОкончания);
		
		Если Строка.ВидРасчета = ПланыВидовРасчета.ВКМ_ОсновныеНачисления.Отпуск Тогда
			// Средний заработок считается за 12 месяцев, предшествующих месяцу начала отпуска.
			Движение.БазовыйПериодНачало = ДобавитьМесяц(НачалоМесяца(Строка.ДатаНачала), -12);
			Движение.БазовыйПериодКонец = НачалоМесяца(Строка.ДатаНачала) - 1;
		Иначе
			Движение.БазовыйПериодНачало = ПериодРегистрации;
			Движение.БазовыйПериодКонец = КонецМесяца(ПериодРегистрации);
		КонецЕсли;
		
	КонецЦикла;
	
	Движения.ВКМ_ОсновныеНачисления.Записать();
	
КонецПроцедуры

Процедура РассчитатьОсновныеНачисления()
	
	НачалоПериода = НачалоМесяца(Дата);
	КонецПериода = КонецМесяца(Дата);
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Начисления.НомерСтроки КАК НомерСтроки,
	|	Начисления.Сотрудник КАК Сотрудник,
	|	Начисления.ВидРасчета КАК ВидРасчета,
	|	Начисления.ПериодДействияНачало КАК ПериодДействияНачало,
	|	Начисления.ПериодДействияКонец КАК ПериодДействияКонец,
	|	Начисления.БазовыйПериодНачало КАК БазовыйПериодНачало,
	|	Начисления.БазовыйПериодКонец КАК БазовыйПериодКонец,
	|	ЕСТЬNULL(Начисления.ЗначениеПериодДействия, 0) КАК ДнейНорма,
	|	ЕСТЬNULL(Начисления.ЗначениеФактическийПериодДействия, 0) КАК ДнейФакт
	|ПОМЕСТИТЬ ВТ_Начисления
	|ИЗ
	|	РегистрРасчета.ВКМ_ОсновныеНачисления.ДанныеГрафика(Регистратор = &Ссылка) КАК Начисления
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	База.НомерСтроки КАК НомерСтроки,
	|	СУММА(База.РезультатБаза) КАК РезультатБаза
	|ПОМЕСТИТЬ ВТ_База
	|ИЗ
	|	(ВЫБРАТЬ
	|		БазаОсновные.НомерСтроки КАК НомерСтроки,
	|		БазаОсновные.РезультатБаза КАК РезультатБаза
	|	ИЗ
	|		РегистрРасчета.ВКМ_ОсновныеНачисления.БазаВКМ_ОсновныеНачисления(
	|				&Измерения,
	|				&Измерения,
	|				,
	|				Регистратор = &Ссылка
	|					И ВидРасчета = ЗНАЧЕНИЕ(ПланВидовРасчета.ВКМ_ОсновныеНачисления.Отпуск)) КАК БазаОсновные
	|	
	|	ОБЪЕДИНИТЬ ВСЕ
	|	
	|	ВЫБРАТЬ
	|		БазаДополнительные.НомерСтроки,
	|		БазаДополнительные.РезультатБаза
	|	ИЗ
	|		РегистрРасчета.ВКМ_ОсновныеНачисления.БазаВКМ_ДополнительныеНачисления(
	|				&Измерения,
	|				&Измерения,
	|				,
	|				Регистратор = &Ссылка
	|					И ВидРасчета = ЗНАЧЕНИЕ(ПланВидовРасчета.ВКМ_ОсновныеНачисления.Отпуск)) КАК БазаДополнительные) КАК База
	|
	|СГРУППИРОВАТЬ ПО
	|	База.НомерСтроки
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ_Начисления.НомерСтроки КАК НомерСтроки,
	|	ВТ_Начисления.ВидРасчета КАК ВидРасчета,
	|	ВТ_Начисления.ДнейНорма КАК ДнейНорма,
	|	ВТ_Начисления.ДнейФакт КАК ДнейФакт,
	|	ЕСТЬNULL(УсловияОплаты.Оклад, 0) КАК Оклад,
	|	ЕСТЬNULL(УсловияОплаты.ПроцентОтРабот, 0) КАК ПроцентОтРабот,
	|	ЕСТЬNULL(ВыполненныеРаботы.СуммаКОплатеОборот, 0) КАК СуммаЗаРаботы,
	|	ЕСТЬNULL(ВТ_База.РезультатБаза, 0) КАК База,
	|	ЕСТЬNULL(ДниБазы.РабочихДней, 0) КАК РабочихДнейБазы,
	|	РАЗНОСТЬДАТ(ВТ_Начисления.ПериодДействияНачало, ВТ_Начисления.ПериодДействияКонец, ДЕНЬ) + 1 КАК КалендарныхДней
	|ИЗ
	|	ВТ_Начисления КАК ВТ_Начисления
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ВКМ_УсловияОплатыСотрудников.СрезПоследних(&КонецПериода, ) КАК УсловияОплаты
	|		ПО ВТ_Начисления.Сотрудник = УсловияОплаты.Сотрудник
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.ВКМ_ВыполненныеСотрудникомРаботы.Обороты(&НачалоПериода, &КонецПериода, , ) КАК ВыполненныеРаботы
	|		ПО ВТ_Начисления.Сотрудник = ВыполненныеРаботы.Сотрудник
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_База КАК ВТ_База
	|		ПО ВТ_Начисления.НомерСтроки = ВТ_База.НомерСтроки
	|		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
	|			ВТ_НачисленияОтпуск.НомерСтроки КАК НомерСтроки,
	|			СУММА(ГрафикРаботы.Значение) КАК РабочихДней
	|		ИЗ
	|			ВТ_Начисления КАК ВТ_НачисленияОтпуск
	|				ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.ВКМ_ГрафикРаботы КАК ГрафикРаботы
	|				ПО (ГрафикРаботы.Дата МЕЖДУ ВТ_НачисленияОтпуск.БазовыйПериодНачало И ВТ_НачисленияОтпуск.БазовыйПериодКонец)
	|		ГДЕ
	|			ВТ_НачисленияОтпуск.ВидРасчета = ЗНАЧЕНИЕ(ПланВидовРасчета.ВКМ_ОсновныеНачисления.Отпуск)
	|		
	|		СГРУППИРОВАТЬ ПО
	|			ВТ_НачисленияОтпуск.НомерСтроки) КАК ДниБазы
	|		ПО ВТ_Начисления.НомерСтроки = ДниБазы.НомерСтроки";
	
	Измерения = Новый Массив;
	Измерения.Добавить("Сотрудник");
	
	Запрос.УстановитьПараметр("Ссылка", Ссылка);
	Запрос.УстановитьПараметр("Измерения", Измерения);
	Запрос.УстановитьПараметр("НачалоПериода", НачалоПериода);
	Запрос.УстановитьПараметр("КонецПериода", КонецПериода);
	
	РезультатыРасчета = Новый Соответствие;
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		РезультатыРасчета.Вставить(Выборка.НомерСтроки, РассчитатьСтроку(Выборка));
	КонецЦикла;
	
	НомерСтроки = 0;
	Для Каждого Движение Из Движения.ВКМ_ОсновныеНачисления Цикл
		НомерСтроки = НомерСтроки + 1;
		Расчет = РезультатыРасчета[НомерСтроки];
		Если Расчет <> Неопределено Тогда
			ЗаполнитьЗначенияСвойств(Движение, Расчет);
		КонецЕсли;
	КонецЦикла;
	
	Движения.ВКМ_ОсновныеНачисления.Записать();
	
КонецПроцедуры

Функция РассчитатьСтроку(ДанныеСтроки)
	
	Результат = Новый Структура("Сумма, Показатель, ДнейНорма, ДнейФакт", 0, 0, ДанныеСтроки.ДнейНорма, ДанныеСтроки.ДнейФакт);
	
	Если ДанныеСтроки.ВидРасчета = ПланыВидовРасчета.ВКМ_ОсновныеНачисления.Оклад Тогда
		
		// Оклад пропорционально отработанным дням: дни отпуска вытеснены из фактического периода.
		Результат.Показатель = ДанныеСтроки.Оклад;
		Если ДанныеСтроки.ДнейНорма <> 0 Тогда
			Результат.Сумма = Окр(ДанныеСтроки.Оклад * ДанныеСтроки.ДнейФакт / ДанныеСтроки.ДнейНорма, 2);
		КонецЕсли;
		
	ИначеЕсли ДанныеСтроки.ВидРасчета = ПланыВидовРасчета.ВКМ_ОсновныеНачисления.ПроцентОтРабот Тогда
		
		// Сумма к оплате уже рассчитана документами Обслуживание клиента с учетом процента.
		Результат.Показатель = ДанныеСтроки.ПроцентОтРабот;
		Результат.Сумма = ДанныеСтроки.СуммаЗаРаботы;
		
	ИначеЕсли ДанныеСтроки.ВидРасчета = ПланыВидовРасчета.ВКМ_ОсновныеНачисления.Отпуск Тогда
		
		// (Начислено за 12 месяцев / Количество рабочих дней) х Количество календарных дней отпуска.
		Результат.ДнейФакт = ДанныеСтроки.КалендарныхДней;
		Если ДанныеСтроки.РабочихДнейБазы <> 0 Тогда
			Результат.Показатель = Окр(ДанныеСтроки.База / ДанныеСтроки.РабочихДнейБазы, 2);
			Результат.Сумма = Окр(ДанныеСтроки.База / ДанныеСтроки.РабочихДнейБазы * ДанныеСтроки.КалендарныхДней, 2);
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Процедура СформироватьДвиженияУдержаний()
	
	ПериодРегистрации = НачалоМесяца(Дата);
	
	Движения.ВКМ_Удержания.Записывать = Истина;
	Для Каждого Строка Из НачисленоПоСотрудникам() Цикл
		Движение = Движения.ВКМ_Удержания.Добавить();
		Движение.ПериодРегистрации = ПериодРегистрации;
		Движение.ВидРасчета = ПланыВидовРасчета.ВКМ_Удержания.НДФЛ;
		Движение.Сотрудник = Строка.Сотрудник;
		Движение.БазовыйПериодНачало = ПериодРегистрации;
		Движение.БазовыйПериодКонец = КонецМесяца(ПериодРегистрации);
		Движение.Сумма = ВКМ_РасчетЗарплаты.СуммаНДФЛ(Строка.Сумма);
	КонецЦикла;
	
КонецПроцедуры

Процедура СформироватьДвиженияВзаиморасчетов()
	
	НДФЛПоСотрудникам = Новый Соответствие;
	Для Каждого Движение Из Движения.ВКМ_Удержания Цикл
		НДФЛПоСотрудникам.Вставить(Движение.Сотрудник, Движение.Сумма);
	КонецЦикла;
	
	Движения.ВКМ_ВзаиморасчетыССотрудниками.Записывать = Истина;
	Для Каждого Строка Из НачисленоПоСотрудникам() Цикл
		Движение = Движения.ВКМ_ВзаиморасчетыССотрудниками.ДобавитьПриход();
		Движение.Период = Дата;
		Движение.Сотрудник = Строка.Сотрудник;
		Движение.Сумма = Строка.Сумма - ?(НДФЛПоСотрудникам[Строка.Сотрудник] = Неопределено, 0, НДФЛПоСотрудникам[Строка.Сотрудник]);
	КонецЦикла;
	
КонецПроцедуры

