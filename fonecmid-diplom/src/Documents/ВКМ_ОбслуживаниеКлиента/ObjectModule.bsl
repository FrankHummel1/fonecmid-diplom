#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ОбработчикиСобытий

Процедура ОбработкаЗаполнения(ДанныеЗаполнения, ТекстЗаполнения, СтандартнаяОбработка)
	
	Ответственный = Пользователи.ТекущийПользователь();
	
	Если Не ЗначениеЗаполнено(ДатаПроведенияРабот) Тогда
		ДатаПроведенияРабот = НачалоДня(ТекущаяДатаСеанса());
	КонецЕсли;
	
КонецПроцедуры

Процедура ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения)
	
	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	
	ЗапомнитьИзмененияДляУведомления();
	
КонецПроцедуры

Процедура ПриЗаписи(Отказ)
	
	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	
	ВКМ_Телеграм.ДобавитьУведомление(ТекстУведомления());
	
КонецПроцедуры

Процедура ОбработкаПроверкиЗаполнения(Отказ, ПроверяемыеРеквизиты)
	
	Если ЗначениеЗаполнено(ВремяНачалаРабот) И ЗначениеЗаполнено(ВремяОкончанияРабот)
		И ВремяОкончанияРабот <= ВремяНачалаРабот Тогда
		
		ОбщегоНазначения.СообщитьПользователю(
			НСтр("ru = 'Время окончания работ должно быть больше времени начала.'"),
			ЭтотОбъект, "ВремяОкончанияРабот", "Объект", Отказ);
		
	КонецЕсли;
	
КонецПроцедуры

Процедура ОбработкаПроведения(Отказ, РежимПроведения)
	
	ДанныеДоговора = ДанныеДоговора();
	
	ПроверитьДоговор(ДанныеДоговора, Отказ);
	Если Отказ Тогда
		Возврат;
	КонецЕсли;
	
	ПроцентОтРабот = ПроцентОтРаботСпециалиста(Отказ);
	Если Отказ Тогда
		Возврат;
	КонецЕсли;
	
	СформироватьДвиженияВыполненныеКлиентуРаботы(ДанныеДоговора);
	СформироватьДвиженияВыполненныеСотрудникомРаботы(ДанныеДоговора, ПроцентОтРабот);
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

#Область УведомленияТелеграм

// Сохраняет в дополнительных свойствах признак новой заявки и прежние значения
// реквизитов планирования, чтобы после записи сформировать текст уведомления.
//
Процедура ЗапомнитьИзмененияДляУведомления()
	
	ЭтоНоваяЗаявка = ЭтоНовый();
	ДополнительныеСвойства.Вставить("ЭтоНоваяЗаявка", ЭтоНоваяЗаявка);
	
	Если ЭтоНоваяЗаявка Тогда
		Возврат;
	КонецЕсли;
	
	ДополнительныеСвойства.Вставить("ПрежниеЗначения", ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Ссылка,
		"ДатаПроведенияРабот, ВремяНачалаРабот, ВремяОкончанияРабот, Специалист"));
	
КонецПроцедуры

Функция ТекстУведомления()
	
	ОписаниеЗаявки = СтрШаблон(НСтр("ru = 'Заявка № %1. Клиент: %2.
		|Специалист: %3.
		|Время работ: %4.
		|Проблема: %5'"),
		Номер, Клиент, Специалист, ПредставлениеВремениРабот(ДатаПроведенияРабот, ВремяНачалаРабот, ВремяОкончанияРабот),
		ОписаниеПроблемы);
	
	Если ДополнительныеСвойства.Свойство("ЭтоНоваяЗаявка") И ДополнительныеСвойства.ЭтоНоваяЗаявка Тогда
		Возврат НСтр("ru = 'Новая заявка на обслуживание.'") + Символы.ПС + ОписаниеЗаявки;
	КонецЕсли;
	
	ПрежниеЗначения = Неопределено;
	Если Не ДополнительныеСвойства.Свойство("ПрежниеЗначения", ПрежниеЗначения) Тогда
		Возврат "";
	КонецЕсли;
	
	Изменения = Новый Массив;
	Если ПрежниеЗначения.Специалист <> Специалист Тогда
		Изменения.Добавить(СтрШаблон(НСтр("ru = 'специалист: %1 -> %2'"), ПрежниеЗначения.Специалист, Специалист));
	КонецЕсли;
	Если ПрежниеЗначения.ДатаПроведенияРабот <> ДатаПроведенияРабот
		Или ПрежниеЗначения.ВремяНачалаРабот <> ВремяНачалаРабот
		Или ПрежниеЗначения.ВремяОкончанияРабот <> ВремяОкончанияРабот Тогда
		Изменения.Добавить(СтрШаблон(НСтр("ru = 'время работ: %1 -> %2'"),
			ПредставлениеВремениРабот(ПрежниеЗначения.ДатаПроведенияРабот, ПрежниеЗначения.ВремяНачалаРабот,
				ПрежниеЗначения.ВремяОкончанияРабот),
			ПредставлениеВремениРабот(ДатаПроведенияРабот, ВремяНачалаРабот, ВремяОкончанияРабот)));
	КонецЕсли;
	
	Если Изменения.Количество() = 0 Тогда
		Возврат "";
	КонецЕсли;
	
	Возврат НСтр("ru = 'Изменена заявка на обслуживание'") + " (" + СтрСоединить(Изменения, "; ") + ")."
		+ Символы.ПС + ОписаниеЗаявки;
	
КонецФункции

Функция ПредставлениеВремениРабот(ДатаРабот, ВремяНачала, ВремяОкончания)
	
	Возврат СтрШаблон("%1 %2-%3", Формат(ДатаРабот, "ДЛФ=D"), Формат(ВремяНачала, "ДФ=ЧЧ:мм"),
		Формат(ВремяОкончания, "ДФ=ЧЧ:мм"));
	
КонецФункции

#КонецОбласти

Функция ДанныеДоговора()
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ДоговорыКонтрагентов.ВидДоговора КАК ВидДоговора,
	|	ДоговорыКонтрагентов.ВКМ_ДатаНачала КАК ДатаНачала,
	|	ДоговорыКонтрагентов.ВКМ_ДатаОкончания КАК ДатаОкончания,
	|	ДоговорыКонтрагентов.ВКМ_СтоимостьЧасаРаботы КАК СтоимостьЧасаРаботы
	|ИЗ
	|	Справочник.ДоговорыКонтрагентов КАК ДоговорыКонтрагентов
	|ГДЕ
	|	ДоговорыКонтрагентов.Ссылка = &Договор";
	Запрос.УстановитьПараметр("Договор", Договор);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Выборка.Следующий();
	
	Возврат Выборка;
	
КонецФункции

Процедура ПроверитьДоговор(ДанныеДоговора, Отказ)
	
	Если ДанныеДоговора.ВидДоговора <> Перечисления.ВидыДоговоровКонтрагентов.ВКМ_АбонентскоеОбслуживание Тогда
		
		ОбщегоНазначения.СообщитьПользователю(
			НСтр("ru = 'Выбран договор, который не является договором абонентского обслуживания.'"),
			ЭтотОбъект, "Договор", "Объект", Отказ);
		Возврат;
		
	КонецЕсли;
	
	ДатаДокумента = НачалоДня(Дата);
	Если ДатаДокумента < ДанныеДоговора.ДатаНачала
		Или (ЗначениеЗаполнено(ДанныеДоговора.ДатаОкончания) И ДатаДокумента > ДанныеДоговора.ДатаОкончания) Тогда
		
		ТекстСообщения = СтрШаблон(
			НСтр("ru = 'Дата документа не входит в период действия договора (с %1 по %2).'"),
			Формат(ДанныеДоговора.ДатаНачала, "ДЛФ=D"),
			Формат(ДанныеДоговора.ДатаОкончания, "ДЛФ=D"));
		ОбщегоНазначения.СообщитьПользователю(ТекстСообщения, ЭтотОбъект, "Дата", "Объект", Отказ);
		
	КонецЕсли;
	
КонецПроцедуры

// Возвращает процент от работ специалиста на дату документа.
// Если процент не установлен (нет записи условий оплаты), документ не проводится;
// нулевой процент допустим.
//
Функция ПроцентОтРаботСпециалиста(Отказ)
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	УсловияОплаты.ПроцентОтРабот КАК ПроцентОтРабот
	|ИЗ
	|	РегистрСведений.ВКМ_УсловияОплатыСотрудников.СрезПоследних(&Дата, Сотрудник = &Специалист) КАК УсловияОплаты";
	Запрос.УстановитьПараметр("Дата", Дата);
	Запрос.УстановитьПараметр("Специалист", Специалист);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.ПроцентОтРабот;
	КонецЕсли;
	
	ОбщегоНазначения.СообщитьПользователю(
		СтрШаблон(НСтр("ru = 'Для специалиста %1 на %2 не установлен процент от выполненных работ.'"),
			Специалист, Формат(Дата, "ДЛФ=D")),
		ЭтотОбъект, "Специалист", "Объект", Отказ);
	Возврат 0;
	
КонецФункции

Процедура СформироватьДвиженияВыполненныеСотрудникомРаботы(ДанныеДоговора, ПроцентОтРабот)
	
	Движения.ВКМ_ВыполненныеСотрудникомРаботы.Записывать = Истина;
	
	ЧасовКОплате = ВыполненныеРаботы.Итог("ЧасыКОплатеКлиенту");
	Если ЧасовКОплате = 0 Тогда
		Возврат;
	КонецЕсли;
	
	// СуммаКОплате = ЧасовКОплатеКлиенту * СтавкаЧасаКлиента * ПроцентОтРабот / 100
	Движение = Движения.ВКМ_ВыполненныеСотрудникомРаботы.Добавить();
	Движение.Период = Дата;
	Движение.Сотрудник = Специалист;
	Движение.ЧасовКОплате = ЧасовКОплате;
	Движение.СуммаКОплате = Окр(ЧасовКОплате * ДанныеДоговора.СтоимостьЧасаРаботы * ПроцентОтРабот / 100, 2);
	
КонецПроцедуры

Процедура СформироватьДвиженияВыполненныеКлиентуРаботы(ДанныеДоговора)
	
	Движения.ВКМ_ВыполненныеКлиентуРаботы.Записывать = Истина;
	
	КоличествоЧасов = ВыполненныеРаботы.Итог("ЧасыКОплатеКлиенту");
	Если КоличествоЧасов = 0 Тогда
		Возврат;
	КонецЕсли;
	
	Движение = Движения.ВКМ_ВыполненныеКлиентуРаботы.Добавить();
	Движение.Период = Дата;
	Движение.Клиент = Клиент;
	Движение.Договор = Договор;
	Движение.КоличествоЧасов = КоличествоЧасов;
	Движение.СуммаКОплате = Окр(КоличествоЧасов * ДанныеДоговора.СтоимостьЧасаРаботы, 2);
	
КонецПроцедуры

#КонецОбласти

#КонецЕсли
