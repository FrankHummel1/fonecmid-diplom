// Дополняет график работы днями пятидневной рабочей недели за период.
// Уже введенные дни (например, праздники, отмеченные вручную) не изменяются.
//
// Параметры:
//  НачалоПериода - Дата - начало заполняемого периода.
//  КонецПериода  - Дата - окончание заполняемого периода.
//
Процедура ЗаполнитьПоУмолчанию(Знач НачалоПериода, Знач КонецПериода) Экспорт
	
	НачалоПериода = НачалоДня(НачалоПериода);
	КонецПериода = НачалоДня(КонецПериода);
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ГрафикРаботы.Дата КАК Дата
	|ИЗ
	|	РегистрСведений.ВКМ_ГрафикРаботы КАК ГрафикРаботы
	|ГДЕ
	|	ГрафикРаботы.Дата МЕЖДУ &НачалоПериода И &КонецПериода";
	Запрос.УстановитьПараметр("НачалоПериода", НачалоПериода);
	Запрос.УстановитьПараметр("КонецПериода", КонецПериода);
	
	ЗаполненныеДаты = Новый Соответствие;
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		ЗаполненныеДаты.Вставить(Выборка.Дата, Истина);
	КонецЦикла;
	
	НаборЗаписей = СоздатьНаборЗаписей();
	ТекущаяДата = НачалоПериода;
	Пока ТекущаяДата <= КонецПериода Цикл
		Если ЗаполненныеДаты[ТекущаяДата] = Неопределено Тогда
			Запись = НаборЗаписей.Добавить();
			Запись.Дата = ТекущаяДата;
			Запись.Значение = ?(ДеньНедели(ТекущаяДата) <= 5, 1, 0);
		КонецЕсли;
		ТекущаяДата = ТекущаяДата + 86400;
	КонецЦикла;
	
	Если НаборЗаписей.Количество() > 0 Тогда
		НаборЗаписей.Записать(Ложь);
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#КонецЕсли
