#Область ПрограммныйИнтерфейс

// Возвращает максимальную суммарную длительность отпусков сотрудника за год.
//
// Возвращаемое значение:
//  Число - количество календарных дней.
//
Функция ЛимитДнейОтпуска() Экспорт
	
	Возврат 28;
	
КонецФункции

// Пересчитывает календарные дни отпусков и признак превышения лимита
// (по сумме всех отпусков сотрудника в графике).
//
// Параметры:
//  ОтпускаСотрудников - ТабличнаяЧасть, ДанныеФормыКоллекция - строки с колонками
//                       Сотрудник, ДатаНачала, ДатаОкончания, ДнейОтпуска, ПревышенЛимит.
//
Процедура ПересчитатьДниОтпусков(ОтпускаСотрудников) Экспорт
	
	ДнейПоСотрудникам = Новый Соответствие;
	
	Для Каждого Строка Из ОтпускаСотрудников Цикл
		
		Строка.ДнейОтпуска = 0;
		Если ЗначениеЗаполнено(Строка.ДатаНачала) И ЗначениеЗаполнено(Строка.ДатаОкончания)
			И Строка.ДатаОкончания >= Строка.ДатаНачала Тогда
			Строка.ДнейОтпуска = (НачалоДня(Строка.ДатаОкончания) - НачалоДня(Строка.ДатаНачала)) / 86400 + 1;
		КонецЕсли;
		
		ВсегоДней = ДнейПоСотрудникам[Строка.Сотрудник];
		ДнейПоСотрудникам.Вставить(Строка.Сотрудник, ?(ВсегоДней = Неопределено, 0, ВсегоДней) + Строка.ДнейОтпуска);
		
	КонецЦикла;
	
	Лимит = ЛимитДнейОтпуска();
	Для Каждого Строка Из ОтпускаСотрудников Цикл
		Строка.ПревышенЛимит = ДнейПоСотрудникам[Строка.Сотрудник] > Лимит;
	КонецЦикла;
	
КонецПроцедуры

#КонецОбласти
