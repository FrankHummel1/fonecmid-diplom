#Область ПрограммныйИнтерфейс

// Возвращает ставку НДФЛ в процентах.
//
// Возвращаемое значение:
//  Число - ставка налога.
//
Функция СтавкаНДФЛ() Экспорт
	
	Возврат 13;
	
КонецФункции

// Рассчитывает сумму НДФЛ с облагаемой суммы.
//
// Параметры:
//  ОблагаемаяСумма - Число - начисленная сумма.
//
// Возвращаемое значение:
//  Число - сумма налога, округленная до рублей.
//
Функция СуммаНДФЛ(ОблагаемаяСумма) Экспорт
	
	Возврат Окр(ОблагаемаяСумма * СтавкаНДФЛ() / 100, 0);
	
КонецФункции

#КонецОбласти
